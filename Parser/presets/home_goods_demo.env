# Home goods Market Analytics demo preset.
# Run with:
#   .\.venv\Scripts\python.exe .\runner.py --config .\presets\home_goods_demo.env

PARSER_MARKETPLACE=wildberries
PARSER_PARENT_CATEGORY=Товары для дома
PARSER_SUBCATEGORY_ALLOWLIST=Органайзеры для хранения вещей,Коврики для ванной,Светильники бра
PARSER_SOURCE_REGION_DEST=12354108

# Keep the preset on the existing safe runner defaults.
PARSER_OUTPUT_BASE_DIR=E:/AshmesMarketplaces/Parser/output
PARSER_INCLUDE_XLSX=true
PARSER_ENABLE_RAW_SAMPLES=false
PARSER_RAW_SAMPLE_LIMIT=3
PARSER_ACQUIRE_TOKEN=true
PARSER_MAX_CONCURRENT=1
PARSER_BATCH_SIZE=5
PARSER_TIMEOUT_SECONDS=10
PARSER_MAX_RETRIES=2
PARSER_REQUEST_DELAY_MIN_SECONDS=2
PARSER_REQUEST_DELAY_MAX_SECONDS=5
PARSER_BATCH_DELAY_MIN_SECONDS=15
PARSER_BATCH_DELAY_MAX_SECONDS=30
PARSER_MAX_CATALOG_PAGES_PER_SUBCATEGORY=0
PARSER_MAX_ITEMS_PER_SUBCATEGORY=0
PARSER_MAX_LIMIT_SIGNALS_PER_SUBCATEGORY=2
PARSER_FAIL_FAST=false
PARSER_PRODUCT_FETCH_MODE=price_split
PARSER_INCLUDE_WB_WALLET_PRICES=true
