# Safe WB parser debug configuration.
# Copy to Parser/.env for local runs. Parser/.env is ignored by git.

PARSER_MARKETPLACE=wildberries
PARSER_PARENT_CATEGORY=Обувь
PARSER_SUBCATEGORY_ALLOWLIST=Обувь для девочек,Обувь для мальчиков
PARSER_SOURCE_REGION_DEST=12354108

# Keep output isolated from backend/frontend dev stack.
PARSER_OUTPUT_BASE_DIR=E:/AshmesMarketplaces/Parser/output
PARSER_INCLUDE_XLSX=true
PARSER_ENABLE_RAW_SAMPLES=false
PARSER_RAW_SAMPLE_LIMIT=3

# Token handling. Leave PARSER_WB_TOKEN empty to let SeleniumBase acquire x_wbaas_token.
PARSER_ACQUIRE_TOKEN=true
PARSER_WB_TOKEN=

# Safe debug limits. Do not raise these for broad parsing without a reviewed plan.
PARSER_MAX_CONCURRENT=1
PARSER_BATCH_SIZE=5
PARSER_TIMEOUT_SECONDS=10
PARSER_MAX_RETRIES=2
PARSER_REQUEST_DELAY_MIN_SECONDS=2
PARSER_REQUEST_DELAY_MAX_SECONDS=5
PARSER_BATCH_DELAY_MIN_SECONDS=15
PARSER_BATCH_DELAY_MAX_SECONDS=30
# 0 means no artificial cap inside the explicit allowlist.
# Set positive values for tiny debug runs.
PARSER_MAX_CATALOG_PAGES_PER_SUBCATEGORY=0
PARSER_MAX_ITEMS_PER_SUBCATEGORY=0
PARSER_MAX_LIMIT_SIGNALS_PER_SUBCATEGORY=2
PARSER_FAIL_FAST=false

# WB wallet price enrichment uses small static WB requests.
PARSER_INCLUDE_WB_WALLET_PRICES=true

# Public WB reviews runner. It reads products.jsonl from an existing product run.
PARSER_REVIEWS_ENDPOINT_BASE=https://feedbacks1.wb.ru/feedbacks/v1
PARSER_REVIEWS_MAX_CONCURRENT=3
PARSER_REVIEWS_TIMEOUT_SECONDS=10
PARSER_REVIEWS_MAX_RETRIES=2
PARSER_REVIEWS_REQUEST_DELAY_MIN_SECONDS=1
PARSER_REVIEWS_REQUEST_DELAY_MAX_SECONDS=3
PARSER_REVIEWS_BACKOFF_BASE_SECONDS=1
PARSER_REVIEWS_BACKOFF_MAX_SECONDS=30
PARSER_REVIEWS_RETAIN_RAW_PAYLOADS=true
PARSER_REVIEWS_RAW_PAYLOAD_COMPRESSION=gzip
PARSER_REVIEWS_FAIL_FAST=false
