{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "AshmesMarketplaces",
    "Audience": "AshmesMarketplaces.Api",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "Intelligence": {
    "Enabled": false,
    "BaseUrl": "http://127.0.0.1:8020",
    "TimeoutSeconds": 20,
    "MaxProductsPerRequest": 1000,
    "HotProductsAlgorithm": "rule_based_hot_products_v1"
  },
  "AllowedHosts": "*"
}
