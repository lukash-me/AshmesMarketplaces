COMPOSE_PROJECT_NAME=ashmes

# Host name only. Do not include https:// here.
ASHMES_PUBLIC_HOST=app.ashmp.ru

POSTGRES_DB=ashmes_marketplaces
POSTGRES_USER=ashmes
POSTGRES_PASSWORD=change-me

# Use full HTTPS origins for JWT issuer/audience.
JWT_ISSUER=https://app.ashmp.ru
JWT_AUDIENCE=https://app.ashmp.ru
JWT_SIGNING_KEY=change-me-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

INTELLIGENCE_ENABLED=true
INTELLIGENCE_LOG_LEVEL=INFO
